<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if title %}{{ title }} - {% endif %}Michele Nasti's blog</title>
        <link rel="stylesheet" href="/css/simple-v1.min.css">
        <link rel="stylesheet" href="/css/prism-okaidia.css">
		<link rel="stylesheet" href="/css/custom.css">
        {% include 'metadata.html' %}
        {% include 'analytics.html' %}
    </head>
    <body>
        <div id="color-switcher" title="Change theme">
            {% include "icons/palette.svg" %}
        </div>
        <header>
            {% responsiveImage '/images/volto.jpg', { width: 150, height: 150, alt: 'Michele Nasti' }, { widths: [150, 263, 300, 450], sizes: '150px', fallbackWidth: 300 } %}
            <h1>Michele Nasti</h1>
            <p>Thoughts on what I learn</p>
            <nav>
                <a href="/" class="blog-name">Home</a>
                <a href="/chi-sono-michele-nasti/">About</a>
                <a href="/talks-conferences/">Talks & Conferences</a>
                <a href="/tags/">Tags</a>
                <a href="/archives/">All my articles in one page</a>
            </nav>
        </header>
        <main>
                {{ content | safe }}
        </main>
        {% include 'footer.html' %}
        <script src="/scripts/index.js"></script>
    </body>
</html>
